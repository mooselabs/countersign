# countersign.service: cnd, socket-activated by countersign.socket.
# Installed by packaging/install.sh. Every directive below was checked against
# systemd.exec(5) and systemd.resource-control(5) of systemd 261.
[Unit]
Description=countersign secret daemon
Documentation=https://github.com/mooselabs/countersign
Requires=countersign.socket
After=countersign.socket

[Service]
# cnd sends READY=1 once it serves, and on SIGHUP (systemctl reload) reloads
# /etc/countersign/config.toml, sending RELOADING=1 then READY=1. A config
# that does not load leaves the previous one in force (see the journal).
Type=notify-reload
ExecStart=/usr/libexec/countersign/cnd
User=countersign
Group=countersign

# Store, keyslots and audit log. cnd also reads $STATE_DIRECTORY.
StateDirectory=countersign
StateDirectoryMode=0700
# No RuntimeDirectory=: /run/countersign holds the socket, and systemd would
# chown a RuntimeDirectory recursively to countersign:countersign, taking the
# socket away from the countersign-users group.

# The master key, sealed with systemd-creds at install. It appears read-only
# at $CREDENTIALS_DIRECTORY/countersign-mk, readable by this unit's user only.
LoadCredentialEncrypted=countersign-mk

UMask=0077
LimitCORE=0
# No memlock limit, so cnd locks all of its memory, now and later
# (mlockall MCL_CURRENT|MCL_FUTURE|MCL_ONFAULT), and secret values never
# reach swap. Under systemd's default limit (8 MiB) cnd can lock only what is
# mapped at startup, since MCL_FUTURE would make every allocation past the
# limit fail; the store, grants and requests are allocated later, unlocked.
# mlockall needs no capability while the limit allows it, and
# @system-service below includes @memlock.
LimitMEMLOCK=infinity
# Each connection holds its socket and the peer's pidfd, and each live
# session its anchor's pidfd; [limits] caps both per uid at 128, for every
# allowed uid. The default soft limit of 1024 descriptors is too tight for
# that; this one is far above it.
LimitNOFILE=65536

# No privileges: cnd needs no capability at all.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem: read-only everywhere except the state directory.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# "default", not "invisible": cnd walks the developer's processes through
# /proc/PID/stat, /proc/PID/comm and /proc/PID/cmdline. No ProcSubset=pid
# either: cnd reads /proc/sys/kernel/random/boot_id.
ProtectProc=default

# Network: AF_UNIX only. That covers the listening socket, sd_notify and the
# system D-Bus socket cnd uses to reach polkitd and logind (both are
# filesystem sockets, so a private network namespace does not hide them).
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# No [Install] section: the service starts on the first connection to
# countersign.socket. Enable the socket, not the service.
